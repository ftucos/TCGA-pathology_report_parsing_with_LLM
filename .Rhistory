LVI_discrepant <- comparison %>%
mutate(LVI.gdc = recode_values(
LVI.gdc,
c("[Not Available]", "[Not Reported]") ~ "Unknown",
"NO" ~ "Absent",
"YES" ~ "Present",
default - "Unknown"),
LVI.llm = ifelse(LVI.llm == "", "Unknown", LVI.llm)
)
LVI_discrepant <- comparison %>%
mutate(LVI.gdc = recode_values(
LVI.gdc,
c("[Not Available]", "[Not Reported]") ~ "Unknown",
"NO" ~ "Absent",
"YES" ~ "Present",
default ~ "Unknown"),
LVI.llm = ifelse(LVI.llm == "", "Unknown", LVI.llm)
)
?recode_values
LVI_discrepant <- comparison %>%
mutate(LVI.gdc = replace_values(
LVI.gdc,
c("[Not Available]", "[Not Reported]") ~ "Unknown",
"NO" ~ "Absent",
"YES" ~ "Present",
default ~ "Unknown"),
LVI.llm = ifelse(LVI.llm == "", "Unknown", LVI.llm)
)
LVI_discrepant <- comparison %>%
mutate(LVI.gdc = recode_values(
LVI.gdc,
c("[Not Available]", "[Not Reported]") ~ "Unknown",
"NO" ~ "Absent",
"YES" ~ "Present",
default = "Unknown"),
